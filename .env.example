# Copy to .env (docker compose reads it automatically) and change the values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# true when served over HTTPS
SESSION_COOKIE_SECURE=false
# true = reject templates whose named counter is not configured in templates.json
NAMED_COUNTERS_REQUIRE_CONFIG=false
# host port for PostgreSQL (pgAdmin/psql); container port stays 5432
POSTGRES_HOST_PORT=5433
# true = issuance requires X-API-Key (or an admin session)
API_KEY_REQUIRED=false
